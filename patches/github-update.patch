+#if BUILDFLAG(IS_WIN)
+// ── GitHub Auto-Update Helper ──────────────────────────────────────────
+namespace github_updater {
+
+namespace {
+
+base::NoDestructor<UpdateState> g_update_state;
+base::NoDestructor<base::RepeatingCallbackList<void(const UpdateState&)>> g_observers;
+
+void NotifyObservers() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  g_observers->Notify(*g_update_state);
+}
+
+void SetState(State state, int progress = 0, std::string version = "", std::u16string message = u"") {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  g_update_state->state = state;
+  g_update_state->progress = progress;
+  if (!version.empty()) g_update_state->version = version;
+  g_update_state->message = message;
+  NotifyObservers();
+}
+
+struct DownloadResult {
+  bool success = false;
+  std::wstring path;
+  std::string version;
+  std::u16string message;
+};
+
+}  // namespace
+
+UpdateState GetUpdateState() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  return *g_update_state;
+}
+
+base::CallbackListSubscription AddObserver(StatusCallback callback) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  callback.Run(*g_update_state);
+  return g_observers->Add(std::move(callback));
+}
+
+void CheckForUpdate(bool user_initiated) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (g_update_state->state == kChecking || g_update_state->state == kDownloading) {
+    return;
+  }
+
+  if (!user_initiated && g_update_state->state == kNearlyUpdated) {
+    NotifyObservers();
+    return;
+  }
+
+  SetState(kChecking);
+
+  auto ui_task_runner = base::SingleThreadTaskRunner::GetCurrentDefault();
+
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::BindOnce([](scoped_refptr<base::SequencedTaskRunner> ui_runner) -> DownloadResult {
+        DownloadResult res;
+
+        auto WinHttpGet = [](const wchar_t* host, const wchar_t* path,
+                             const wchar_t* headers,
+                             scoped_refptr<base::SequencedTaskRunner> progress_runner) -> std::optional<std::string> {
+          HINTERNET session = WinHttpOpen(L"ChromiumMV2-Updater/1.0", WINHTTP_ACCESS_TYPE_DEFAULT_PROXY, NULL, NULL, 0);
+          if (!session) return std::nullopt;
+          HINTERNET connect = WinHttpConnect(session, host, INTERNET_DEFAULT_HTTPS_PORT, 0);
+          HINTERNET request = WinHttpOpenRequest(connect, L"GET", path, NULL, WINHTTP_NO_REFERER, WINHTTP_DEFAULT_ACCEPT_TYPES, WINHTTP_FLAG_SECURE);
+          std::string body;
+
+          DWORD headers_len = headers ? -1L : 0;
+          if (WinHttpSendRequest(request, headers ? headers : WINHTTP_NO_ADDITIONAL_HEADERS, headers_len, WINHTTP_NO_REQUEST_DATA, 0, 0, 0) &&
+              WinHttpReceiveResponse(request, NULL)) {
+            DWORD status_code = 0;
+            DWORD status_code_size = sizeof(status_code);
+            if (WinHttpQueryHeaders(request, WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER,
+                                    WINHTTP_HEADER_NAME_BY_INDEX, &status_code, &status_code_size, WINHTTP_NO_HEADER_INDEX)) {
+              if (status_code < 200 || status_code >= 300) {
+                if (request) WinHttpCloseHandle(request);
+                if (connect) WinHttpCloseHandle(connect);
+                if (session) WinHttpCloseHandle(session);
+                return std::nullopt;
+              }
+            }
+
+            wchar_t content_length_str[32] = {0};
+            DWORD dw_size = sizeof(content_length_str);
+            int64_t total_bytes = 0;
+            if (WinHttpQueryHeaders(request, WINHTTP_QUERY_CONTENT_LENGTH, WINHTTP_HEADER_NAME_BY_INDEX, content_length_str, &dw_size, WINHTTP_NO_HEADER_INDEX)) {
+              total_bytes = _wtoi64(content_length_str);
+            }
+
+            DWORD avail = 0;
+            int64_t bytes_read = 0;
+            int last_progress = -1;
+            while (WinHttpQueryDataAvailable(request, &avail) && avail > 0) {
+              std::vector<char> buf(avail);
+              DWORD read = 0;
+              if (WinHttpReadData(request, buf.data(), avail, &read) && read > 0) {
+                body.append(buf.data(), read);
+                bytes_read += read;
+                if (total_bytes > 0 && progress_runner) {
+                  int progress = static_cast<int>((bytes_read * 100) / total_bytes);
+                  if (progress > last_progress) {
+                    last_progress = progress;
+                    progress_runner->PostTask(
+                        FROM_HERE,
+                        base::BindOnce([](int p) {
+                          DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+                          if (g_update_state->state == kDownloading) {
+                            g_update_state->progress = p;
+                            NotifyObservers();
+                          }
+                        }, progress));
+                  }
+                }
+              }
+            }
+          }
+          if (request) WinHttpCloseHandle(request);
+          if (connect) WinHttpCloseHandle(connect);
+          if (session) WinHttpCloseHandle(session);
+          return body.empty() ? std::nullopt : std::make_optional(body);
+        };
+
+        const wchar_t* api_headers = L"Accept: application/vnd.github+json\r\n" L"X-GitHub-Api-Version: 2022-11-28\r\n";
+        auto body = WinHttpGet(L"api.github.com", L"/repos/naminx/chromium-mv2/releases/latest", api_headers, nullptr);
+        if (!body) {
+          res.message = u"Failed to check GitHub releases.";
+          return res;
+        }
+
+        auto parsed = base::JSONReader::ReadAndReturnValueWithError(*body, base::JSON_PARSE_RFC);
+        if (!parsed.has_value() || !parsed->is_dict()) {
+          res.message = u"Failed to parse release JSON.";
+          return res;
+        }
+
+        const auto& root = parsed->GetDict();
+        const std::string* tag = root.FindString("tag_name");
+        const base::ListValue* assets = root.FindList("assets");
+        if (!tag || !assets) {
+          res.message = u"Invalid release info from GitHub.";
+          return res;
+        }
+
+        std::string cleaned_tag = ((*tag)[0] == 'v' ? tag->substr(1) : *tag);
+        res.version = cleaned_tag;
+
+        if (base::Version(cleaned_tag) <= base::Version(CHROME_VERSION_STRING)) {
+          res.success = true;
+          return res;
+        }
+
+        ui_runner->PostTask(
+            FROM_HERE,
+            base::BindOnce([](std::string ver) {
+              SetState(kDownloading, 0, ver);
+            }, cleaned_tag));
+
+        for (const auto& asset_val : *assets) {
+          const auto& asset = asset_val.GetDict();
+          const std::string* name = asset.FindString("name");
+          const std::string* dl_url = asset.FindString("browser_download_url");
+          if (name && dl_url && base::StartsWith(*name, "chromium-mv2-")) {
+            base::FilePath temp_dir;
+            if (!base::GetTempDir(&temp_dir)) {
+              res.message = u"Failed to get temp directory.";
+              return res;
+            }
+            base::FilePath dest = temp_dir.Append(L"chrome_update.exe");
+
+            URL_COMPONENTS comps = { sizeof(comps), NULL, 0, INTERNET_SCHEME_HTTPS, NULL, 0, 0, NULL, 0, NULL, 0, NULL, 0 };
+            wchar_t host[256], upath[2048];
+            comps.lpszHostName = host; comps.dwHostNameLength = 256;
+            comps.lpszUrlPath = upath; comps.dwUrlPathLength = 2048;
+
+            if (WinHttpCrackUrl(base::UTF8ToWide(*dl_url).c_str(), 0, 0, &comps)) {
+              auto bin = WinHttpGet(host, upath, nullptr, ui_runner);
+              if (bin && base::WriteFile(dest, *bin)) {
+                res.success = true;
+                res.path = dest.value();
+                return res;
+              }
+            }
+          }
+        }
+        res.message = u"No suitable asset found.";
+        return res;
+      }, ui_task_runner),
+      base::BindOnce([](DownloadResult res) {
+        DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+        if (res.success) {
+          if (res.path.empty()) {
+            SetState(kUpdated, 0, res.version);
+          } else {
+            SHELLEXECUTEINFO sei = { sizeof(sei), SEE_MASK_NOCLOSEPROCESS, NULL, L"open", res.path.c_str(), L"--do-not-launch-chrome", NULL, SW_HIDE };
+            if (ShellExecuteExW(&sei)) {
+              SetState(kNearlyUpdated, 0, res.version);
+            } else {
+              SetState(kFailed, 0, res.version, u"Failed to launch update installer.");
+            }
+          }
+        } else {
+          SetState(kFailed, 0, res.version, res.message);
+        }
+      }));
+}
+
+}  // namespace github_updater
